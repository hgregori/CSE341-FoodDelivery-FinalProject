  "image": "/images/restaurants/tokyo-express.jpg"
}

### 4. PUT - Update restaurant by ID (Replace with a valid ID)
PUT {{baseUrl}}/restaurants/6abd917edd6772b461ea47de
Content-Type: application/json

{
  "name": "Sakura Sushi & Grill House",
