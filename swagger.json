{
  "swagger": "2.0",
  "info": {
    "title": "CSE341 Final Project - Henrique Gregorio",
    "description": "Food Delivery API for CSE341 - Henrique Gregorio",
    "version": "1.0.0"
  },
  "host": "cse341-fooddelivery-finalproject.onrender.com",
  "basePath": "/",
  "tags": [
    {
      "name": "Foods",
      "description": "Operations related to food items and menu"
    },
    {
      "name": "Restaurants",
      "description": "Operations related to restaurants"
    }
  ],
  "schemes": [
    "https"
  ],
  "paths": {
    "/menu": {
      "get": {
        "tags": [
          "Foods"
        ],
        "description": "Get all foods from the menu",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "List of all food items"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Foods"
        ],
        "description": "Create a new food item",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Food object to create",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Food"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Food created successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/menu/{id}": {
      "get": {
        "tags": [
          "Foods"
        ],
        "description": "Get a single food item by ID",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Food ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Food item data"
          },
          "400": {
            "description": "Invalid ID format"
          },
          "404": {
            "description": "Food not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "put": {
        "tags": [
          "Foods"
        ],
        "description": "Update a food item by ID",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Food ID"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Food object with updated fields",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Food"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Food updated successfully"
          },
          "400": {
            "description": "Invalid ID format"
          },
          "404": {
            "description": "Food not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "delete": {
        "tags": [
          "Foods"
        ],
        "description": "Delete a food item by ID",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Food ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Food deleted successfully"
          },
          "400": {
            "description": "Invalid ID format"
          },
          "404": {
            "description": "Food not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/restaurants": {
      "get": {
        "tags": [
          "Restaurants"
        ],
        "description": "Get all restaurants",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "List of all restaurants"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Restaurants"
        ],
        "description": "Create a new restaurant",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Restaurant object to create",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Restaurant"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Restaurant created successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/restaurants/{id}": {
      "get": {
        "tags": [
          "Restaurants"
        ],
        "description": "Get a single restaurant by ID",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Restaurant ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Restaurant data"
          },
          "400": {
            "description": "Invalid ID format"
          },
          "404": {
            "description": "Restaurant not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "put": {
        "tags": [
          "Restaurants"
        ],
        "description": "Update a restaurant by ID",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Restaurant ID"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Restaurant object with updated fields",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Restaurant"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Restaurant updated successfully"
          },
          "400": {
            "description": "Invalid ID format"
          },
          "404": {
            "description": "Restaurant not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "delete": {
        "tags": [
          "Restaurants"
        ],
        "description": "Delete a restaurant by ID",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Restaurant ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Restaurant deleted successfully"
          },
          "400": {
            "description": "Invalid ID format"
          },
          "404": {
            "description": "Restaurant not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "definitions": {
    "Food": {
      "type": "object",
      "properties": {
        "restaurantId": {
          "type": "string",
          "example": "6abd917edd6772b461ea47e2"
        },
        "name": {
          "type": "string",
          "example": "Fried Rice"
        },
        "price": {
          "type": "number",
          "example": 12.49
        },
        "amount": {
          "type": "string",
          "example": "1 plate"
        },
        "ingredients": {
          "type": "array",
          "example": [
            "rice",
            "egg",
            "carrot",
            "peas",
            "soy sauce"
          ],
          "items": {
            "type": "string"
          }
        },
        "image": {
          "type": "string",
          "example": "/images/foods/fried-rice.jpg"
        },
        "imageAlt": {
          "type": "string",
          "example": "Plate of fried rice with vegetables and egg"
        },
        "category": {
          "type": "string",
          "example": "Main Course"
        },
        "featured": {
          "type": "boolean",
          "example": true
        },
        "available": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "Restaurant": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Sakura Sushi House"
        },
        "address": {
          "type": "string",
          "example": "125 Cherry Blossom Ave, New York, NY"
        },
        "cuisine": {
          "type": "string",
          "example": "Japanese"
        },
        "rating": {
          "type": "number",
          "example": 4.8
        },
        "description": {
          "type": "string",
          "example": "Authentic Japanese cuisine featuring fresh sushi, sashimi, ramen, and traditional dishes prepared daily."
        },
        "openingHours": {
          "type": "string",
          "example": "11:00 AM - 10:00 PM"
        },
        "deliveryFee": {
          "type": "number",
          "example": 3.99
        },
        "image": {
          "type": "string",
          "example": "/images/restaurants/sakura-sushi-house.jpg"
        }
      }
    }
  }
}