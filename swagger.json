  "definitions": {
    "Food": {
      "type": "object",
      "properties": {
        "restaurantId": {
          "type": "string",
          "example": "6abd917edd6772b461ea47e2"
        },
        "name": {
          "type": "string",
          "example": "Fried Rice"
        },
        "price": {
          "type": "number",
          "example": 12.49
        },
        "amount": {
          "type": "string",
          "example": "1 plate"
        },
        "ingredients": {
          "type": "array",
          "example": [
            "rice",
            "egg",
            "carrot",
            "peas",
            "soy sauce"
          ],
          "items": {
            "type": "string"
          }
        },
        "image": {
          "type": "string",
          "example": "/images/foods/fried-rice.jpg"
        },
        "imageAlt": {
          "type": "string",
          "example": "Plate of fried rice with vegetables and egg"
        },
        "category": {
          "type": "string",
          "example": "Main Course"
        },
        "featured": {
          "type": "boolean",
          "example": true
        },
        "available": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "Restaurant": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Sakura Sushi House"
        },
        "address": {
          "type": "string",
          "example": "125 Cherry Blossom Ave, New York, NY"
        },
        "cuisine": {
          "type": "string",
          "example": "Japanese"
        },
        "rating": {
          "type": "number",
          "example": 4.8
        },
        "description": {
          "type": "string",
          "example": "Authentic Japanese cuisine featuring fresh sushi, sashimi, ramen, and traditional dishes prepared daily."
        },
        "openingHours": {
          "type": "string",
          "example": "11:00 AM - 10:00 PM"
        },
        "deliveryFee": {
          "type": "number",
          "example": 3.99
        },
        "image": {
          "type": "string",
          "example": "/images/restaurants/sakura-sushi-house.jpg"
        }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Henrique Gregorio"
        },
        "email": {
          "type": "string",
          "example": "henrique@example.com"
        },
        "role": {
          "type": "string",
          "example": "customer"
        },
        "active": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "Transaction": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "example": "6ac6c819bd09052255094358"
        },
        "restaurantId": {
          "type": "string",
          "example": "6abd917edd6772b461ea47de"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "foodId": {
                "type": "string",
                "example": "6abd93afdd6772b461ea47e8"
              },
              "name": {
                "type": "string",
                "example": "Fried Rice"
              },
              "unitPrice": {
                "type": "number",
                "example": 12.49
              },
              "quantity": {
                "type": "number",
                "example": 2
              },
              "subtotal": {
                "type": "number",
                "example": 24.98
              }
            }
          }
        },
        "totalPrice": {
          "type": "number",
          "example": 28.97
        },
        "status": {
          "type": "string",
          "example": "pending"
        }
      }
    }
  }
